# ============================================================
# FILE MẪU BIẾN MÔI TRƯỜNG — COPY THÀNH .env VÀ ĐIỀN GIÁ TRỊ
# ============================================================
# CẢNH BÁO: File .env thật TUYỆT ĐỐI không được commit lên Git!
# ============================================================

# === BLOCKCHAIN (Alchemy + Ví Admin) ===
# Lấy từ: https://dashboard.alchemy.com → Create App → Sepolia
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key của ví admin dùng để trả phí Gas
# Lấy từ: MetaMask → Account Details → Export Private Key
# ⚠️ KHÔNG DÙNG VÍ CÓ TIỀN THẬT!
PRIVATE_KEY=your_wallet_private_key_here

# === ADMIN WALLETS ===
# Địa chỉ ví (public) được phép đăng nhập Admin
# Nhiều admin: phân cách bằng dấu phẩy (không có khoảng trắng)
ADMIN_WALLET_ADDRESSES=0xYourWalletAddress1,0xYourWalletAddress2

# === DJANGO ===
# Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-random-secret-key-at-least-50-chars

# Secret riêng cho webhook Indexer → Django (KHÁC với DJANGO_SECRET_KEY)
# Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=your-internal-api-secret-here

DEBUG=True                    # Đổi thành False khi deploy Production
SESSION_COOKIE_AGE=86400      # Thời gian sống session (giây) — 86400 = 24 giờ

# === DATABASE ===
# True = dùng SQLite local (không cần cài thêm gì)
# False = dùng PostgreSQL (cần DATABASE_URL)
USE_SQLITE=True

# Chỉ cần khi USE_SQLITE=False
# Lấy từ: Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# === REDIS ===
# Cần cho: WebSocket real-time + RQ background tasks
# Local: redis://localhost:6379/0
# Render: lấy từ Redis service URL trên Dashboard
REDIS_URL=redis://localhost:6379/0

# === IPFS (Pinata) ===
# Lấy từ: https://app.pinata.cloud → API Keys → New Key → chọn pinFileToIPFS
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
